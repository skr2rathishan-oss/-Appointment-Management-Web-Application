# Used when running the server outside Docker (npm run dev).
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:5173

# Points at the MySQL container's published port (MYSQL_HOST_PORT in the root .env)
DB_HOST=localhost
DB_PORT=3307
DB_USER=ams_user
DB_PASSWORD=change_me
DB_NAME=appointment_db

# Secret used to sign login tokens (JWT). Use a long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=1d

# Time zone the clinic works in (IANA name). Decides "today" and past slots.
CLINIC_TZ=Asia/Colombo
