{
  "name": "appointment-management-server",
  "version": "1.0.0",
  "private": true,
  "description": "REST API for the healthcare appointment management system",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "dev:docker": "nodemon --legacy-watch src/server.js",
