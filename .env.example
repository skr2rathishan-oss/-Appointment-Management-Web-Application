# Used by docker-compose.yml. Copy to .env and change the passwords.
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=appointment_db
MYSQL_USER=ams_user
MYSQL_PASSWORD=change_me
# Host port for MySQL (3307 avoids clashing with a locally installed MySQL)
MYSQL_HOST_PORT=3307

# Secret used to sign login tokens (JWT). Use a long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change_me_to_a_long_random_string

# Time zone the clinic works in (IANA name). Decides "today" and past slots.
CLINIC_TZ=Asia/Colombo
